# Trading Bot — Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env to git

# === MetaTrader 5 ===
MT5_LOGIN=0
MT5_SERVER=YourServer-Demo
# MT5_PASSWORD is NOT stored — entered at runtime

# === Telegram ===
# Get from: https://my.telegram.org
TELEGRAM_API_ID=0
TELEGRAM_API_HASH=
TELEGRAM_PHONE=

# === Telegram Bot ===
# Get from: @BotFather on Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# === Gemini (optional) ===
# Get from: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# === Proxy (if needed) ===
# PROXY_SOCKS5=socks5://127.0.0.1:10808
